{
  "manifest_version": 3,
  "name": "Kaelia Local Browser",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Share one browser tab with your Kaelia workspace.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kaelia Local Browser",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://agents.synviocore.xyz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://agents.synviocore.xyz/*"
      ],
      "js": [
        "workspace-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
