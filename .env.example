# Set real values in Vercel > Settings > Environment Variables, never in Git.
# Use a unique random password (at least 20 characters).
SYNVIO_PASSWORD=
# Use a separate random session secret (at least 32 characters).
SYNVIO_SESSION_SECRET=
OPENAI_API_KEY=

# Connect the free Upstash Redis integration in Vercel Storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Explicitly enable task setup; the UI then offers "Przygotuj środowisko testów".
SYNVIO_ENABLE_TASKS=0
# At most 10 nontrivial chat messages + task starts per UTC day by default.
# Optional administrator override for the daily request count.
# SYNVIO_DAILY_REQUEST_LIMIT=10
# gpt-4o-mini is the default; enable gpt-4o only consciously.
SYNVIO_ALLOW_EXPENSIVE_MODELS=0

# Optional alternative to preparing the test image through the UI:
SYNVIO_SANDBOX_SNAPSHOT=

# Local cloud-adapter development only; NEVER set this to 1 on Vercel.
SYNVIO_CLOUD_DEV=0
